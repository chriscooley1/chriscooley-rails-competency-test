doctype html
html lang="en"
  head
    title= content_for?(:title) ? "#{content_for(:title)} · Simple News" : "Simple News"
    meta name="viewport" content="width=device-width,initial-scale=1"
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags
  body
    header
      p= link_to "Simple News", root_path
      nav
        = link_to "Home", root_path
        = link_to "All stories", articles_path
        = link_to "Write", new_article_path
    - if notice
      p= notice
    - if alert
      p= alert
    main
      = yield
