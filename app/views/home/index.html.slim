- content_for :title, "Front page"
- if user_signed_in?
  p.lede The first three stories from each section.
- else
  p.lede The first three stories from each section. Create an account to read a story in full.

- @articles_by_category.each do |category, articles|
  section.category-block id="category-#{category.parameterize}"
    header.section-head
      h2= category
      = link_to "More #{category}", articles_path(category: category), class: "more"
    - if articles.any?
      .grid
        - articles.each do |article|
          article.story
            h3= link_to article.title, article
            p.dek= article_excerpt(article)
            p.meta
              = article.user.email
              span.dot ·
              = story_date(article.created_at)
    - else
      p.empty Nothing filed in this section yet.
