- content_for :title, "Front page"
- if user_signed_in?
  p.lede The first three stories from each section.
- else
  p.lede The first three stories from each section. Create an account to read a story in full.

- @articles_by_category.each do |section, articles|
  section.category-block class=section.name.parameterize id="category-#{section.name.parameterize}" style=section_style(section)
    header.section-head
      h2= section.name
      = link_to "More #{section.name}", articles_path(category: section.name), class: "more"
    - if articles.any?
      .grid
        - articles.each_with_index do |article, index|
          article.story class=("lead" if index.zero?)
            h3= link_to article.title, article
            p.dek= article_excerpt(article)
            p.meta
              = article.user.email
              span.dot ·
              = story_date(article.created_at)
    - else
      p.empty Nothing filed in this section yet.
