= render "shared/form_errors", record: @user, noun: "account"
= form_with model: [:admin, @user] do |form|
  p
    = form.label :email
    br
    = form.email_field :email, required: true, autofocus: true, autocomplete: "off"
  p
    = form.label :role
    br
    = form.select :role, User.role_options
  p
    = form.label :password
    br
    - if @user.persisted?
      | Leave this blank to keep the current password.
    - else
      | #{User.password_length.min} characters minimum.
    br
    = form.password_field :password, autocomplete: "new-password", required: @user.new_record?
  p
    = form.label :password_confirmation, "Confirm password"
    br
    = form.password_field :password_confirmation, autocomplete: "new-password", required: @user.new_record?
  p
    = form.submit(@user.new_record? ? "Create account" : "Save account")
    |  
    = link_to "Cancel", admin_users_path
