- content_for :title, "People"
h1 People
p Create accounts and choose who can publish.
p= link_to "New user", new_admin_user_path

table
  thead
    tr
      th Email
      th Role
      th
  tbody
    - @users.each do |user|
      tr
        td= user.email
        td= user.role_label
        td= link_to "Edit", edit_admin_user_path(user)
