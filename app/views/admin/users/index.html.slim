- content_for :title, "People"
header.page-head
  h1 People
  = link_to "New user", new_admin_user_path, class: "button"
p.lede Create accounts and choose who can publish.

.table-wrap
  table.people
    thead
      tr
        th Email
        th Role
        th
    tbody
      - @users.each do |user|
        tr
          td= user.email
          td
            span.badge= user.role_label
          td.actions= link_to "Edit", edit_admin_user_path(user)
