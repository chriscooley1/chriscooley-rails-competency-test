- content_for :title, "Sign up"
section.auth-card
  h1 Sign up
  p.hint This creates a reader account. An admin assigns editor and admin roles.
  = form_for(resource, as: resource_name, url: registration_path(resource_name)) do |form|
    = render "devise/shared/error_messages", resource: resource
    .field
      = form.label :email
      = form.email_field :email, autofocus: true, autocomplete: "email", required: true
    .field
      = form.label :password
      - if @minimum_password_length
        p.hint= "#{@minimum_password_length} characters minimum."
      = form.password_field :password, autocomplete: "new-password", required: true
    .field
      = form.label :password_confirmation
      = form.password_field :password_confirmation, autocomplete: "new-password", required: true
    .actions
      = form.submit "Sign up"
  = render "devise/shared/links"
