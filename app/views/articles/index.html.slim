- content_for :title, (@category || "All stories")
h1= @category || "All stories"
nav
  = link_to "All", articles_path
  - Article::CATEGORIES.each do |category|
    = link_to category, articles_path(category: category)

- if @articles.any?
  - @articles.each do |article|
    article
      p= article.category
      h2= link_to article.title, article
      p= article.user.email
      p= truncate(article.content.to_s.squish, length: 180)
- else
  p No stories yet.
